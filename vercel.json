{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/mobile",
      "destination": "/access",
      "permanent": true
    },
    {
      "source": "/mobile/:path*",
      "destination": "/access/:path*",
      "permanent": true
    }
  ]
}
